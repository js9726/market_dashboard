#!/bin/sh
# Shared Claude/Codex claim gate. Install with:
#   git config core.hooksPath scripts/githooks
set -eu

repo="$(git rev-parse --show-toplevel)"
fail() { echo "pre-commit BLOCKED: $1" >&2; exit 1; }

[ -n "${JIE_AGENT_ACTOR:-}" ] || fail "set JIE_AGENT_ACTOR to Claude, Codex, or Jie"

canonical_common=""
for primary in "$repo/../jie_wiki" "$repo/../../jie_wiki"; do
  if git -C "$primary" rev-parse --git-common-dir >/dev/null 2>&1; then
    canonical_common="$(git -C "$primary" rev-parse --path-format=absolute --git-common-dir)"
    break
  fi
done
[ -n "$canonical_common" ] || fail "canonical primary jie_wiki Git repository is unavailable"

control=""
for wiki in "${JIE_WIKI_ROOT:-}" "$repo/../jie_wiki" "$repo/../../jie_wiki"; do
  [ -n "$wiki" ] || continue
  candidate_common="$(git -C "$wiki" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [ "$candidate_common" = "$canonical_common" ] && [ -f "$wiki/scripts/agent_control.py" ]; then
    control="$wiki/scripts/agent_control.py"
    break
  fi
done
[ -n "$control" ] || fail "canonical jie_wiki/scripts/agent_control.py is unavailable"

python "$control" --repo "$repo" verify-staged >/dev/null || \
  fail "staged paths are not covered by the active claim owned by JIE_AGENT_ACTOR"

exit 0
